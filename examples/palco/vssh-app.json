{
  "id": "palco",
  "name": "Palco",
  "version": "5.0.0",
  "icon": "icon.svg",
  "category": "AudioVideo",
  "developer": { "name": "colabhd", "url": "https://github.com/colabhd" },
  "license": "MIT",
  "description": "O player de vídeo e música do ambiente. Toca o arquivo aberto no gerenciador de arquivos e segue pela pasta, continuando de onde você parou. Quando o navegador não abre um formato sozinho, como AVI ou áudio AC3, o servidor o converte enquanto ele toca. Troca a faixa de áudio e a legenda, e mostra a capa das músicas.",
  "requiredPackages": [
    "ffmpeg"
  ],
  "recursos": {
    "gpu": { "modo": "opcional" }
  },
  "resources": {
    "memoryMax": "1G",
    "tasksMax": "128"
  },
  "opens": {
    "extensions": [
      "mp4", "m4v", "mkv", "webm", "avi", "mov", "wmv", "flv", "ts", "mpg", "mpeg", "ogv",
      "mp3", "m4a", "flac", "wav", "ogg", "opus", "aac", "wma", "mka"
    ],
    "mimeTypes": [
      "video/mp4", "video/x-matroska", "video/webm", "video/quicktime", "video/x-msvideo",
      "video/mpeg", "video/ogg", "video/x-ms-wmv", "video/x-flv", "video/mp2t",
      "audio/mpeg", "audio/mp4", "audio/flac", "audio/wav", "audio/ogg", "audio/aac",
      "audio/x-ms-wma", "audio/x-matroska"
    ]
  },
  "minShellVersion": "5.0.0",
  "backend": {
    "runtime": "python3",
    "transport": "socket",
    "entrypoint": "backend/main.py",
    "healthcheckPath": "/saude",
    "aoFechar": "encerrar"
  },
  "window": {
    "title": "Palco",
    "width": 960,
    "height": 600,
    "minimos": { "largura": 480, "altura": 320 },
    "multiplasJanelas": true
  }
}
