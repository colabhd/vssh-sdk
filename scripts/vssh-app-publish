#!/usr/bin/env bash
# vssh-app-publish: empacota um vssh-app e o publica num repositório de artefatos.
# Uso: vssh-app-publish <diretorio|git-url> [--version X] [--repo-api URL] [--token TOKEN] [--icon PATH]
#                        [--notes TEXTO | --notes-file ARQUIVO] [--internal-version AAAAMMDDhhmmss]
#                        [--sitio NOME]
#      vssh-app-publish <diretorio|git-url> --empacotar LOTE [as mesmas opções, sem o token]
#      vssh-app-publish --enviar LOTE [--repo-api URL] [--token TOKEN] [--sitio NOME]
#
# Publicar tem duas metades. Empacotar valida o app, monta o pacote com o ícone, a ajuda e o
# ladrilho, e carimba a versão interna. Enviar manda o que foi empacotado a um repositório. Sem
# `--empacotar` nem `--enviar`, o script faz as duas, como quem publica num repositório só. Com
# mais de um repositório (a Cloudflare e o de cada sítio), `--empacotar` roda uma vez e escreve o
# lote numa pasta, e `--enviar` roda uma vez por repositório, com a mesma pasta: todos recebem os
# mesmos bytes e a mesma interna.
#
# A versão interna é o instante da publicação em UTC, como o inteiro `AAAAMMDDhhmmss`. Ela ordena
# as publicações de um app, e o `version` do manifesto é só o texto exibido. O script a tira do
# relógio ao empacotar, ou a recebe por `--internal-version` (ou VSSH_INTERNAL_VERSION), que é como
# uma publicação que falhou num repositório é completada com a mesma interna. Ela vai no header
# `X-Vssh-Internal-Version` e no `internalVersion` do manifesto do pacote; o manifesto do autor não
# a declara. Antes de mandar o pacote, enviar confere a interna no repositório: o que já tem esta
# publicação não recebe o pacote de novo, e o que tem uma interna mais alta recusa a publicação.
# `--sitio` (ou VSSH_SITIO) é o nome do repositório nas mensagens.
#
# Lê VSSH_REPO_API e VSSH_REPO_PUBLISH_TOKEN do ambiente (ou das flags). Valida o vssh-app.json
# contra `api/vssh-app.schema.json` deste repositório, empacota, confere o sha256 e faz
# POST /v1/publish/app (e o ícone, se houver). Com `icone` no manifesto, monta o ícone em camadas
# (`montar-icone.mjs`) e o põe no lugar do `icon` que o pacote não traz, e monta o ladrilho da Loja,
# que vai ao repositório depois do pacote. Com `contributes.ajuda` no
# manifesto, compila a pasta de ajuda (`compilar-ajuda.mjs`, com o Node), recusa a que não
# compila, escreve o nível no resumo do run e manda o `ajuda.json` ao repositório depois do pacote.
# Roda no CI do repositório do app, pelo `_publish-app-reusable.yml`, e na máquina de quem
# desenvolve.
#
# As notas de versão (`--notes`, `--notes-file`, ou VSSH_RELEASE_NOTES no ambiente) são o que
# mudou NESTA versão, em markdown, e vão para a ficha do app na loja. Um changelog inteiro não é
# isso; o Worker recusa acima de 16 KiB.
#
# Empacotamento: quando a fonte é um repositório git, entram só os arquivos rastreados
# (`git archive`), então um `vendor/` ou `node_modules` commitado viaja no tarball e o que o
# `.gitignore` exclui fica de fora, sem lista de padrões para manter. Fora de um repositório git,
# o `tar` exclui só metadados e cache.
set -euo pipefail

SRC="" VERSION_OVERRIDE="" ICON_OVERRIDE="" EMPACOTAR="" ENVIAR=""
REPO_API="${VSSH_REPO_API:-}"
TOKEN="${VSSH_REPO_PUBLISH_TOKEN:-}"
NOTES="${VSSH_RELEASE_NOTES:-}"
INTERNA="${VSSH_INTERNAL_VERSION:-}"
SITIO="${VSSH_SITIO:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --version)    VERSION_OVERRIDE="$2"; shift 2 ;;
    --repo-api)   REPO_API="$2"; shift 2 ;;
    --token)      TOKEN="$2"; shift 2 ;;
    --icon)       ICON_OVERRIDE="$2"; shift 2 ;;
    --notes)      NOTES="$2"; shift 2 ;;
    --notes-file) [ -f "$2" ] || { echo "ERRO: --notes-file '$2' não existe." >&2; exit 1; }
                  NOTES="$(cat "$2")"; shift 2 ;;
    --internal-version) INTERNA="$2"; shift 2 ;;
    --sitio)      SITIO="$2"; shift 2 ;;
    --empacotar)  EMPACOTAR="$2"; shift 2 ;;
    --enviar)     ENVIAR="$2"; shift 2 ;;
    -h|--help)  grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)          [ -z "${SRC}" ] && SRC="$1" || { echo "Argumento inesperado: $1" >&2; exit 1; }; shift ;;
  esac
done

[ -z "${EMPACOTAR}" ] || [ -z "${ENVIAR}" ] || { echo "ERRO: --empacotar e --enviar são metades diferentes; use uma por vez." >&2; exit 1; }
[ -n "${ENVIAR}" ] || [ -n "${SRC}" ] || { echo "ERRO: informe <diretorio|git-url>." >&2; exit 1; }
[ -z "${ENVIAR}" ] || [ -z "${SRC}" ] || { echo "ERRO: --enviar manda um lote já empacotado, sem <diretorio|git-url>." >&2; exit 1; }
[ -n "${REPO_API}" ] || { echo "ERRO: VSSH_REPO_API (ou --repo-api) não definido." >&2; exit 1; }
# Empacotar lê o repositório (a regra dos apps oficiais) e não escreve nele: dispensa o token.
[ -n "${EMPACOTAR}" ] || [ -n "${TOKEN}" ] || { echo "ERRO: VSSH_REPO_PUBLISH_TOKEN (ou --token) não definido." >&2; exit 1; }
REPO_API="${REPO_API%/}"
# O repositório nas mensagens: o nome que quem chama deu, ou o endereço.
ONDE="${SITIO:-${REPO_API}}"

WORKDIR="$(mktemp -d)"
trap 'rm -rf "${WORKDIR}"' EXIT
PKG="${WORKDIR}/pkg"

# Avisos que aparecem ONDE SE OLHA.
#
# Num log corrido, um aviso é uma linha entre mil — e isso não é hipótese: foi exatamente assim que
# o `aviso: schema não encontrado` passou despercebido em vários repos de app, que publicaram por
# meses com validação mínima achando que estavam validando (ver docs/decisoes/publicacao.md).
# No GitHub Actions, `::warning::` sobe para o resumo do run e para a
# aba de anotações do PR; fora dele, stderr é o lugar certo mesmo.
anotar() {   # anotar <warning|notice> <título> <mensagem...>
  local nivel="$1" titulo="$2"; shift 2
  if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
    # `%0A` é como uma anotação carrega quebra de linha; um \n cru encerraria o comando.
    printf '::%s title=%s::%s\n' "${nivel}" "${titulo}" "$(printf '%s' "$*" | sed ':a;N;$!ba;s/\n/%0A/g')"
  else
    printf '%s: %s\n' "${titulo}" "$*" >&2
  fi
}

# ── Enviar um lote a um repositório ────────────────────────────────────────────
#
# A segunda metade de publicar: manda a um repositório o que `--empacotar` deixou na pasta do lote.
# Roda uma vez por repositório, com a mesma pasta.
#
# Antes do pacote, a conferência da interna, pelo manifesto que o repositório serve do app:
#
#   o app não existe lá, ou a interna do lote é maior que todas     manda o pacote
#   o repositório já tem a interna do lote                          não manda o pacote de novo, e
#                                                                   completa a ajuda, o ícone e o
#                                                                   ladrilho, que podem ter faltado
#   o repositório tem uma interna mais alta                         recusa, com a mais alta
#   o repositório não respondeu                                     recusa, com o nome dele
#
# Um repositório anterior à versão interna não a diz no manifesto: ele recebe o pacote como sempre
# recebeu, e ignora o header.
#
# A ajuda, as figuras e o ladrilho vão depois do pacote, e uma recusa deles é aviso: o app já foi
# publicado. Um repositório que conhece a interna diz `internalVersion` na resposta do pacote, e
# as rotas seguintes levam o `?i=<interna>`, que nomeia esta publicação entre as do mesmo `version`.
enviar_lote() {
  local lote="$1" k v f
  { [ -f "${lote}/lote.txt" ] && [ -f "${lote}/app.tar.gz" ] && [ -f "${lote}/manifesto.json" ]; } \
    || { echo "ERRO: '${lote}' não é um lote do vssh-app-publish --empacotar." >&2; return 1; }
  local APP_ID="" VERSION="" INTERNA="" SHA256="" BUILT_AT="" BUILD_ID="" REF="" AJUDA_NIVEL=0 ICONE="" ICONE_TIPO=""
  local FIGURAS=()
  while IFS='=' read -r k v; do
    v="${v//$'\r'/}"
    case "${k}" in
      APP_ID) APP_ID="${v}";; VERSION) VERSION="${v}";; INTERNA) INTERNA="${v}";; SHA256) SHA256="${v}";;
      BUILT_AT) BUILT_AT="${v}";; BUILD_ID) BUILD_ID="${v}";; REF) REF="${v}";; AJUDA_NIVEL) AJUDA_NIVEL="${v}";;
      ICONE) ICONE="${v}";; ICONE_TIPO) ICONE_TIPO="${v}";; FIGURA) FIGURAS+=("${v}");;
    esac
  done < "${lote}/lote.txt"
  { [[ "${APP_ID}" =~ ^[a-z0-9-]+$ ]] && [[ "${INTERNA}" =~ ^[0-9]{14}$ ]] && [ -n "${VERSION}" ]; } \
    || { echo "ERRO: o lote.txt de '${lote}' não diz o app, a versão e a interna." >&2; return 1; }
  [ "$(sha256sum "${lote}/app.tar.gz" | cut -d' ' -f1)" = "${SHA256}" ] \
    || { echo "ERRO: o pacote de '${lote}' não tem o sha256 que o lote.txt diz." >&2; return 1; }

  # A conferência da interna.
  local codigo estado="" mais_alta=""
  codigo="$(curl -sS -o "${WORKDIR}/publicado.json" -w '%{http_code}' "${REPO_API}/v1/apps/${APP_ID}/manifest.json" 2>"${WORKDIR}/publicado.erro" || true)"
  case "${codigo}" in
    404) estado=novo ;;
    2??)
      while IFS='=' read -r k v; do
        case "${k}" in ESTADO) estado="${v//$'\r'/}";; MAIS_ALTA) mais_alta="${v//$'\r'/}";; esac
      done <<< "$(VSSH_PUBLICADO="${WORKDIR}/publicado.json" VSSH_INTERNA="${INTERNA}" python3 -c '
import json, os
try: d = json.load(open(os.environ["VSSH_PUBLICADO"], encoding="utf-8"))
except Exception: d = {}
d = d if isinstance(d, dict) else {}
vs = [d.get("latest")] + (d.get("history") or [])
internas = [v["internalVersion"] for v in vs if isinstance(v, dict) and isinstance(v.get("internalVersion"), int)]
n = int(os.environ["VSSH_INTERNA"])
print("ESTADO=" + ("tem" if n in internas else "adiante" if internas and max(internas) > n else "novo"))
print("MAIS_ALTA=" + (str(max(internas)) if internas else ""))')"
      ;;
    *)
      echo "ERRO: o repositório ${ONDE} não respondeu à conferência de ${APP_ID} (HTTP ${codigo:-000}): $(head -c 300 "${WORKDIR}/publicado.erro" 2>/dev/null || true)" >&2
      echo "      Nada foi mandado a ele. Para completar esta publicação nele: vssh-app-publish --enviar <lote>, com a interna ${INTERNA}." >&2
      return 1 ;;
  esac
  if [ "${estado}" = adiante ]; then
    echo "ERRO: o repositório ${ONDE} tem ${APP_ID} numa versão interna mais alta (${mais_alta}) que a desta publicação (${INTERNA})." >&2
    echo "      Uma interna só cresce. Publique de novo, com a interna do relógio de agora." >&2
    return 1
  fi

  local seletor=""
  if [ "${estado}" = tem ]; then
    echo "${ONDE} já tem ${APP_ID} na interna ${INTERNA}: o pacote não vai de novo."
    seletor="?i=${INTERNA}"
  else
    echo "Publicando app ${APP_ID}@${VERSION}, interna ${INTERNA}, em ${ONDE} (${SHA256})"
    # As notas vão em base64 num header, como o manifesto: um header não carrega quebra de linha, e
    # markdown é feito delas.
    local notas=()
    [ ! -s "${lote}/notas.md" ] || notas=(-H "X-Vssh-Notes: $(base64 < "${lote}/notas.md" | tr -d '\n')")
    # A coleção vai do mesmo jeito, no header da publicação, e o repositório a guarda com a versão.
    [ ! -s "${lote}/colecao.json" ] || notas+=(-H "X-Vssh-Colecao: $(base64 < "${lote}/colecao.json" | tr -d '\n')")
    codigo="$(curl -sS -o "${WORKDIR}/pacote-resposta" -w '%{http_code}' -X POST "${REPO_API}/v1/publish/app" \
      -H "Authorization: Bearer ${TOKEN}" \
      -H "Content-Type: application/gzip" \
      -H "X-Vssh-App-Id: ${APP_ID}" \
      -H "X-Vssh-Version: ${VERSION}" \
      -H "X-Vssh-Internal-Version: ${INTERNA}" \
      -H "X-Vssh-Build-Id: ${BUILD_ID}" \
      -H "X-Vssh-Ref: ${REF}" \
      -H "X-Vssh-Built-At: ${BUILT_AT}" \
      -H "X-Vssh-Sha256: ${SHA256}" \
      -H "X-Vssh-Manifest: $(base64 < "${lote}/manifesto.json" | tr -d '\n')" \
      "${notas[@]}" \
      --data-binary "@${lote}/app.tar.gz" 2>"${WORKDIR}/pacote.erro" || true)"
    local resposta
    resposta="$(cat "${WORKDIR}/pacote-resposta" 2>/dev/null || true)"
    if [ "${codigo}" != 201 ]; then
      echo "ERRO: o repositório ${ONDE} respondeu ${codigo:-000} ao pacote de ${APP_ID}@${VERSION}: ${resposta:-$(head -c 300 "${WORKDIR}/pacote.erro" 2>/dev/null || true)}" >&2
      return 1
    fi
    echo "${resposta}"
    # O repositório confere o manifesto contra o schema uma segunda vez, e diz quando não conseguiu
    # ler o schema. É a mesma situação do checkout sem `api/`: publicou, e alguém precisa saber que
    # foi sem o gate de lá.
    case "${resposta}" in
      *'"schemaConferido": false'*|*'"schemaConferido":false'*)
        anotar warning "repositório não conferiu o schema" \
          "${ONDE} publicou ${APP_ID}@${VERSION} sem conseguir ler o schema do manifesto; valeu só a validação deste script." ;;
    esac
    case "${resposta}" in *'"internalVersion"'*) seletor="?i=${INTERNA}" ;; esac
  fi
  local da_versao="${REPO_API}/v1/publish/app/${APP_ID}/${VERSION}"

  # A ajuda da versão. O repositório a guarda ao lado do pacote, e o portal a lê de lá. Uma recusa
  # aqui é aviso: o pacote já foi publicado, e o portal compila a ajuda do disco da estação.
  if [ -s "${lote}/ajuda.json" ]; then
    echo "Publicando a ajuda (nível ${AJUDA_NIVEL})"
    codigo="$(curl -sS -o "${WORKDIR}/ajuda-resposta" -w '%{http_code}' -X POST \
      "${da_versao}/ajuda${seletor}" \
      -H "Authorization: Bearer ${TOKEN}" \
      -H "Content-Type: application/json" \
      -H "X-Vssh-Sha256: $(sha256sum "${lote}/ajuda.json" | cut -d' ' -f1)" \
      --data-binary "@${lote}/ajuda.json" || true)"
    if [ "${codigo}" = 201 ]; then
      cat "${WORKDIR}/ajuda-resposta"; echo
      # As figuras vão depois do pacote da ajuda, porque o repositório só as aceita de uma versão
      # que já tem ajuda. Uma recusada é aviso, e o passo dela aparece sem a figura.
      for f in "${FIGURAS[@]}"; do
        codigo="$(curl -sS -o "${WORKDIR}/figura-resposta" -w '%{http_code}' -X POST \
          "${da_versao}/ajuda/${f}${seletor}" \
          -H "Authorization: Bearer ${TOKEN}" \
          -H "Content-Type: image/png" \
          -H "X-Vssh-Sha256: $(sha256sum "${lote}/figuras/${f}" | cut -d' ' -f1)" \
          --data-binary "@${lote}/figuras/${f}" || true)"
        [ "${codigo}" = 201 ] || anotar warning "figura não guardada" \
          "${ONDE} respondeu ${codigo:-000} à figura ${f}: $(head -c 300 "${WORKDIR}/figura-resposta" 2>/dev/null || true)."
      done
      [ "${#FIGURAS[@]}" -eq 0 ] || echo "Figuras da ajuda: ${#FIGURAS[@]}"
    else
      anotar warning "ajuda não guardada" \
        "${ONDE} respondeu ${codigo:-000} à ajuda de ${APP_ID}@${VERSION}: $(head -c 400 "${WORKDIR}/ajuda-resposta" 2>/dev/null || true). O app foi publicado, e o portal compila a ajuda do disco da estação."
    fi
  fi

  # O ícone da versão.
  if [ -n "${ICONE}" ] && [ -f "${lote}/${ICONE}" ]; then
    echo "Publicando ícone (${ICONE_TIPO})"
    curl -fsS -X POST "${da_versao}/icon${seletor}" \
      -H "Authorization: Bearer ${TOKEN}" \
      -H "X-Vssh-Content-Type: ${ICONE_TIPO}" \
      --data-binary "@${lote}/${ICONE}"
    echo
  fi

  # O ladrilho da Loja, o SVG montado das camadas. Um repositório que não o guarda (um anterior à
  # rota, um erro de rede) vira aviso, e a Loja mostra o ícone.
  if [ -f "${lote}/ladrilho.svg" ]; then
    codigo="$(curl -sS -o "${WORKDIR}/ladrilho-resposta" -w '%{http_code}' -X POST \
      "${da_versao}/ladrilho${seletor}" \
      -H "Authorization: Bearer ${TOKEN}" \
      -H "X-Vssh-Content-Type: image/svg+xml" \
      --data-binary "@${lote}/ladrilho.svg" || true)"
    if [ "${codigo}" = 201 ]; then
      echo "Ladrilho da Loja publicado"
    else
      anotar warning "ladrilho não guardado" \
        "${ONDE} respondeu ${codigo:-000} ao ladrilho de ${APP_ID}@${VERSION}: $(head -c 300 "${WORKDIR}/ladrilho-resposta" 2>/dev/null || true). O app foi publicado, e a Loja mostra o ícone dele."
    fi
  fi
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    echo "\`${APP_ID}@${VERSION}\`, interna \`${INTERNA}\`, em ${ONDE}: $([ "${estado}" = tem ] && echo 'já estava publicado' || echo 'publicado')." >> "${GITHUB_STEP_SUMMARY}"
  fi
  echo "✅ ${APP_ID}@${VERSION} publicado em ${ONDE}."
}

if [ -n "${ENVIAR}" ]; then
  enviar_lote "${ENVIAR}"
  exit $?
fi

# ── 1. Materializa a fonte ─────────────────────────────────────────────────────
case "${SRC}" in
  *.git|git@*|https://*.git) git clone --depth 1 "${SRC}" "${PKG}" ;;
  *) [ -d "${SRC}" ] || { echo "ERRO: '${SRC}' não é diretório nem git-url." >&2; exit 1; }
     cp -a "${SRC}" "${PKG}" ;;
esac

MANIFEST="${PKG}/vssh-app.json"
[ -f "${MANIFEST}" ] || { echo "ERRO: vssh-app.json não encontrado na raiz do pacote." >&2; exit 1; }

# ── 2. Valida e (se pedido) reescreve a version no manifest do pacote ──────────
SCHEMA="$(cd "$(dirname "$0")/.." && pwd)/api/vssh-app.schema.json"
INFO="$(VSSH_MANIFEST_PATH="${MANIFEST}" VSSH_VERSION_OVERRIDE="${VERSION_OVERRIDE}" VSSH_SCHEMA_PATH="${SCHEMA}" python3 <<'PYEOF'
import json, os, re, sys
# ⚠ **O encoding vai DECLARADO nas três pontas, e nenhuma delas é hipotética.**
#
# Este bloco lê um manifesto com acento, REESCREVE esse manifesto com `ensure_ascii=False` (a
# linha do `--version`, que roda em toda publicação do CI), e imprime mensagens de erro em
# português. Sem declarar, as três herdam a codificação do locale — e num locale que não seja
# UTF-8 a do meio é a cara: o `name` e a `description` do app sairiam corrompidos DENTRO do
# pacote publicado, sem erro nenhum e sem volta.
#
# Foi a terceira ponta que denunciou as outras: três testes de `publish-validacao` reprovavam no
# Windows há meses comparando `vers�o` com `versão`, e a leitura fácil era "ruído de
# plataforma". Era o mesmo defeito, no lugar mais barato de vê-lo.
sys.stdout.reconfigure(encoding='utf-8')
sys.stderr.reconfigure(encoding='utf-8')
p = os.environ['VSSH_MANIFEST_PATH']
m = json.load(open(p, encoding='utf-8'))
app_id = m.get('id', '')
if not re.match(r'^[a-z0-9-]+$', app_id or ''):
    print('ERROR=id_invalido'); sys.exit(0)
# A versão interna é do pacote, e quem a escreve é este script, uma vez por publicação. Um manifesto
# de origem que a declara publicaria toda vez com a mesma, e o repositório recusaria a segunda.
if 'internalVersion' in m:
    print('ERROR=internalVersion_no_manifesto_de_origem: tire o campo, o publish o carimba'); sys.exit(0)
override = os.environ.get('VSSH_VERSION_OVERRIDE') or ''
if override:
    m['version'] = override
    json.dump(m, open(p, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
version = m.get('version', '')
if not re.match(r'^[0-9A-Za-z][0-9A-Za-z.\-+_]*$', version or ''):
    print('ERROR=version_ausente'); sys.exit(0)
b = m.get('backend', {})
if b.get('runtime') not in ('python3', 'node', 'binary'):
    print('ERROR=runtime_invalido'); sys.exit(0)
if not b.get('entrypoint'):
    print('ERROR=entrypoint_ausente'); sys.exit(0)

# `requiredPackages` tem checagem PRÓPRIA, além da do schema, porque este campo é diferente dos
# outros: o valor dele chega a um gerenciador de pacotes rodando no servidor do usuário. Um nome
# com metacaractere de shell é injeção, e o gate de publicação é onde isso se recusa — depois já
# é tarde, e o portal teria de desconfiar de um manifesto que passou por aqui.
#
# O erro nomeia o valor reprovado: "pacote inválido" sozinho manda quem publica conferir a lista
# inteira à mão.
#
# Cada item é uma EXIGÊNCIA, e uma exigência pode ter ALTERNATIVAS separadas por '|' — o idioma do
# `Depends: a | b` do Debian, e pelo mesmo motivo: "preciso de um navegador do tipo chromium" é uma
# exigência que três pacotes diferentes satisfazem, e declarar só um recusa a instalação em
# servidores onde o app rodaria perfeitamente. O '|' é o ÚNICO metacaractere admitido, e ele nunca
# atravessa como shell: quem confere separa as alternativas antes de montar comando nenhum.
_ALT = r'[a-z0-9][a-z0-9+.\-]*'
pkgs = m.get('requiredPackages')
if pkgs is not None:
    if not isinstance(pkgs, list):
        print('ERROR=requiredPackages_nao_e_lista'); sys.exit(0)
    for nome in pkgs:
        if not isinstance(nome, str) or not re.match(r'^%s( *\| *%s)*$' % (_ALT, _ALT), nome):
            # Um '|' presente mas com uma alternativa torta é o erro provável desta sintaxe — e
            # dizer só "pacote inválido" mandaria conferir a linha inteira em vez do pedaço.
            ruim = next((a for a in str(nome).split('|')
                         if not re.match(r'^%s$' % _ALT, a.strip())), None) if isinstance(nome, str) and '|' in nome else None
            print(f'ERROR=pacote_invalido:{nome!r}' + (f'; a alternativa {ruim.strip()!r} não é nome de pacote' if ruim else ''))
            sys.exit(0)

# `resources` pelo MESMO motivo que `requiredPackages`, e não por simetria: cada valor daqui vira
# um `-p Propriedade=<valor>` numa linha de comando de `systemd-run` rodando como o usuário. O
# schema já casa o padrão, mas o schema é o gate de forma — este é o gate de destino, e ele nomeia
# o campo reprovado em vez de mandar conferir o bloco inteiro.
_RES = {
    'memoryHigh': r'^(none|[0-9]+(\.[0-9]+)?(K|M|G|T|%)?)$',
    'memoryMax':  r'^(none|[0-9]+(\.[0-9]+)?(K|M|G|T|%)?)$',
    'cpuQuota':   r'^(none|[0-9]+%)$',
    'tasksMax':   r'^(none|[0-9]+%?)$',
}
res = m.get('resources')
if res is not None:
    if not isinstance(res, dict):
        print('ERROR=resources_nao_e_objeto'); sys.exit(0)
    for campo, valor in res.items():
        if campo not in _RES:
            print(f'ERROR=resource_desconhecido:{campo!r}'); sys.exit(0)
        if not isinstance(valor, str) or not re.match(_RES[campo], valor):
            print(f'ERROR=resource_invalido:{campo}={valor!r}'); sys.exit(0)

# `gpu` é booleano e SÓ booleano. Um `"true"` em texto passaria pelo schema como tipo errado, mas o
# erro genérico não diria o que está errado — e o servidor trata só `True` como pedido, então um
# manifesto com `"true"` rodaria SEM GPU e o autor não saberia por quê.
gpu = m.get('gpu')
if gpu is not None and not isinstance(gpu, bool):
    print(f'ERROR=gpu_nao_e_booleano:{gpu!r}'); sys.exit(0)

# `secrets` declara NOMES, nunca valores. O nome vira um `export <nome>=` avaliado pelo shell no
# servidor do usuário — é a mesma classe de destino do `requiredPackages`, e por isso o mesmo gate.
segredos = m.get('secrets')
if segredos is not None:
    if not isinstance(segredos, list):
        print('ERROR=secrets_nao_e_lista'); sys.exit(0)
    vistos = set()
    for s in segredos:
        if not isinstance(s, dict):
            print(f'ERROR=secret_nao_e_objeto:{s!r}'); sys.exit(0)
        nome = s.get('name')
        if not isinstance(nome, str) or not re.match(r'^[A-Z][A-Z0-9_]{0,63}$', nome):
            print(f'ERROR=secret_invalido:{nome!r}'); sys.exit(0)
        # Declarar o mesmo nome duas vezes não é erro de forma, é erro de sentido: a tela mostraria
        # dois campos para uma variável só, e o segundo apagaria o primeiro sem dizer nada.
        if nome in vistos:
            print(f'ERROR=secret_duplicado:{nome!r}'); sys.exit(0)
        vistos.add(nome)
        # Um manifesto com o VALOR dentro é o erro que este campo existe para tornar impossível:
        # ele seria commitado, publicado e distribuído a todo servidor que instalasse o app.
        for proibido in ('value', 'valor', 'default'):
            if proibido in s:
                print(f'ERROR=secret_com_valor:{nome!r}'); sys.exit(0)

# `provides` tem checagem própria por um motivo diferente do `requiredPackages`: o valor daqui não
# vai para lugar nenhum perigoso — vira chave de busca. O que ele precisa é de uma mensagem que
# diga o que fazer, porque os dois erros prováveis têm conserto óbvio e o erro do schema não os
# distingue: esquecer a versão (`llm` em vez de `llm/v1`) e declarar a mesma capacidade duas vezes.
#
# A versão é obrigatória e é o ponto do campo. Uma capacidade é contrato entre repositórios que não
# se conhecem; sem versão, mudá-la é quebrar alguém em silêncio.
caps = m.get('provides')
if caps is not None:
    if not isinstance(caps, list):
        print('ERROR=provides_nao_e_lista'); sys.exit(0)
    vistas = set()
    for c in caps:
        if not isinstance(c, str) or not re.match(r'^[a-z][a-z0-9-]*/v[0-9]+$', c):
            falta_versao = isinstance(c, str) and re.match(r'^[a-z][a-z0-9-]*$', c)
            print(f'ERROR=capacidade_invalida:{c!r}' + ('; falta a versão (ex.: %r)' % (c + '/v1') if falta_versao else ''))
            sys.exit(0)
        # Declarar duas vezes não é erro de forma, é erro de sentido — e some na resolução, que
        # trabalha com conjunto. Recusar aqui é o único lugar onde alguém vê.
        if c in vistas:
            print(f'ERROR=capacidade_duplicada:{c!r}'); sys.exit(0)
        vistas.add(c)

# `contributes.browserExtension` aponta para uma extensão do outro catálogo. O validador genérico
# confere o schema, mas ele NÃO implementa maxLength — e a `razao` vai para um diálogo do shell, onde
# uma frase de dez mil caracteres é um problema de tela. O `id` ganha mensagem própria porque o
# engano previsível é pôr aqui a URL do bundle ou o nome de exibição, e o erro do schema diria só
# "pattern".
be = (m.get('contributes') or {}).get('browserExtension')
if be is not None:
    if not isinstance(be, dict):
        print('ERROR=browserExtension_nao_e_objeto'); sys.exit(0)
    ext_id = be.get('id')
    if not isinstance(ext_id, str) or not re.match(r'^[a-z0-9-]+$', ext_id):
        print(f'ERROR=browserExtension_id_invalido:{ext_id!r}; é o `id` da extensão no catálogo '
              '(o mesmo do vssh-ext.json dela), não a URL do bundle nem o nome de exibição')
        sys.exit(0)
    razao = be.get('razao')
    if razao is not None and (not isinstance(razao, str) or not 1 <= len(razao) <= 120):
        print(f'ERROR=browserExtension_razao_invalida; uma frase de até 120 caracteres, e veio '
              f'{len(razao) if isinstance(razao, str) else type(razao).__name__}')
        sys.exit(0)

# `contributes.comandos` põe comandos no terminal de quem instala o app (o `comandos-dos-apps.md` do
# vssh-sso). O schema confere o padrão do nome; aqui fica o que ele não alcança: o prefixo `vssh`,
# que é dos comandos do sistema, o nome repetido no mesmo app, e o arquivo de `roda`, que tem de
# estar no pacote. Os comandos dos outros apps e os da estação o publish não conhece, e quem resolve
# essas colisões é o agente da estação.
comandos = (m.get('contributes') or {}).get('comandos')
if isinstance(comandos, list):
    raiz = os.path.realpath(os.path.dirname(p))
    vistos = set()
    for c in comandos:
        if not isinstance(c, dict):
            continue
        nome, roda = c.get('nome'), c.get('roda')
        if isinstance(nome, str) and nome.startswith('vssh'):
            print(f'ERROR=comando_com_prefixo_do_sistema:{nome!r}; os nomes que começam com vssh são do sistema'); sys.exit(0)
        if nome in vistos:
            print(f'ERROR=comando_duplicado:{nome!r}'); sys.exit(0)
        vistos.add(nome)
        alvo = os.path.realpath(os.path.join(raiz, roda)) if isinstance(roda, str) else ''
        if not isinstance(roda, str) or not alvo.startswith(raiz + os.sep) or not os.path.isfile(alvo):
            print(f'ERROR=comando_sem_arquivo:{nome!r}:{roda!r}; o arquivo de roda tem de estar no pacote'); sys.exit(0)

# `minShellVersion` está de saída: o VSSH deixa de ter versão nominal, e a compatibilidade de um
# app passa a ser a `ponte` dele (a seção 2e). A forma continua conferida, nomeando o valor,
# enquanto o schema tiver o campo, e quem ainda o declara ganha um aviso no run.
msv = m.get('minShellVersion')
if msv is not None and (not isinstance(msv, str) or not re.match(r'^[0-9]+(\.[0-9]+){0,2}$', msv)):
    print(f'ERROR=minShellVersion_invalida:{msv!r}'); sys.exit(0)
if msv is not None: print(f'MINSHELL={msv}')

# `opens.proprios` são os tipos de arquivo que o app cria, e o ambiente desenha o selo de cada um
# com o texto em branco sobre a cor declarada. O schema confere a forma do hex e não alcança o
# contraste; o portal recusa instalar uma cor em que o branco fica abaixo de 4,5:1 (WCAG 2). A mesma
# conta aqui leva a recusa para a publicação, onde quem a lê é quem escolheu a cor.
def _luminancia(hexa):
    def canal(i):
        c = int(hexa[i:i + 2], 16) / 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * canal(1) + 0.7152 * canal(3) + 0.0722 * canal(5)

abre = m.get('opens')
proprios = abre.get('proprios') if isinstance(abre, dict) else None
for t in proprios if isinstance(proprios, list) else []:
    cor = t.get('cor') if isinstance(t, dict) else None
    if isinstance(cor, str) and re.match(r'^#[0-9a-fA-F]{6}$', cor):
        contraste = 1.05 / (_luminancia(cor) + 0.05)
        if contraste < 4.5:
            print(f"ERROR=proprios_sem_contraste:{t.get('extensao')!r}; o branco do selo fica em "
                  f"{contraste:.2f}:1 sobre {cor}, e o mínimo é 4,5:1")
            sys.exit(0)

# Validação completa contra api/vssh-app.schema.json, o contrato do manifesto que o sistema gera
# neste repositório. Este é o portão de entrada no repositório de artefatos, e por isso o rigor
# fica aqui; o vssh-app-install roda offline no servidor e valida só o mínimo
# (id/runtime/entrypoint).
#
# Validador do subconjunto de JSON Schema que o arquivo usa (type, required, properties, enum,
# pattern, items, minimum/maximum, minLength, additionalProperties:false). Sem dependência: este repositório
# não tem node_modules, e o script precisa rodar em qualquer runner.
# "campo desconhecido: requiredPackage" está correto e não ajuda: quem publica olha para o próprio
# manifesto, vê o campo escrito lá, e o erro parece dizer que o schema é que está velho. Nomear o
# vizinho resolve o caso que motivou fechar a raiz — o `s` que faltou — sem inventar nada: se
# nenhum campo conhecido estiver perto, a mensagem continua sendo só o nome reprovado.
def _perto(alvo, conhecidos):
    # Damerau, e não Levenshtein simples, por um caso concreto: `widht` por `width`. Trocar dois
    # vizinhos de lugar é o erro de digitação mais comum que existe, e a distância simples o cobra
    # como DOIS erros — então justamente o typo mais provável ficava sem sugestão.
    def dist(a, b):
        la, lb = len(a), len(b)
        d = [[0] * (lb + 1) for _ in range(la + 1)]
        for i in range(la + 1): d[i][0] = i
        for j in range(lb + 1): d[0][j] = j
        for i in range(1, la + 1):
            for j in range(1, lb + 1):
                d[i][j] = min(d[i-1][j] + 1, d[i][j-1] + 1, d[i-1][j-1] + (a[i-1] != b[j-1]))
                if i > 1 and j > 1 and a[i-1] == b[j-2] and a[i-2] == b[j-1]:
                    d[i][j] = min(d[i][j], d[i-2][j-2] + 1)
        return d[la][lb]
    if not conhecidos: return None
    melhor = min(conhecidos, key=lambda c: (dist(alvo.lower(), c.lower()), c))
    # Teto proporcional: num nome curto ('gpu') dois erros já são outra palavra; num longo
    # ('requiredPackages') dois erros ainda são o mesmo campo mal digitado.
    return melhor if dist(alvo.lower(), melhor.lower()) <= max(1, len(melhor) // 5) else None

def _validate(node, schema, path='', errors=None):
    if errors is None: errors = []
    t = schema.get('type')
    types = t if isinstance(t, list) else ([t] if t else [])
    def bad(msg): errors.append(f"{path or '<raiz>'}: {msg}")
    if node is None and 'null' in types: return errors
    if types:
        ok = any(
            (ty == 'object' and isinstance(node, dict)) or
            (ty == 'array' and isinstance(node, list)) or
            (ty == 'string' and isinstance(node, str)) or
            (ty == 'integer' and isinstance(node, int) and not isinstance(node, bool)) or
            (ty == 'boolean' and isinstance(node, bool)) or
            (ty == 'null' and node is None)
            for ty in types)
        if not ok:
            bad(f"esperava {'/'.join(types)}, veio {type(node).__name__}"); return errors
    if 'enum' in schema and node not in schema['enum']:
        bad(f"valor inválido {node!r}; esperado um de {schema['enum']}")
    if isinstance(node, str) and 'pattern' in schema and not re.search(schema['pattern'], node):
        bad(f"{node!r} não casa com {schema['pattern']}")
    if isinstance(node, str) and 'minLength' in schema and len(node) < schema['minLength']:
        bad(f"vazio; precisa de ao menos {schema['minLength']} caractere(s)")
    if isinstance(node, int) and not isinstance(node, bool):
        if 'minimum' in schema and node < schema['minimum']: bad(f"{node} < mínimo {schema['minimum']}")
        if 'maximum' in schema and node > schema['maximum']: bad(f"{node} > máximo {schema['maximum']}")
    if isinstance(node, dict):
        for req in schema.get('required', []):
            if req not in node: bad(f"campo obrigatório ausente: {req}")
        props = schema.get('properties', {})
        if schema.get('additionalProperties') is False:
            for k in node:
                if k not in props:
                    vizinho = _perto(k, list(props))
                    bad(f"campo desconhecido: {k}" + (f" (você quis dizer {vizinho}?)" if vizinho else ''))
        for k, sub in props.items():
            if k in node: _validate(node[k], sub, f"{path}.{k}" if path else k, errors)
    if isinstance(node, list) and 'items' in schema:
        for i, item in enumerate(node):
            _validate(item, schema['items'], f"{path}[{i}]", errors)
    return errors

schema_path = os.environ.get('VSSH_SCHEMA_PATH') or ''
if schema_path and os.path.isfile(schema_path):
    try:
        problems = _validate(m, json.load(open(schema_path, encoding='utf-8')))
    except Exception as e:
        problems = []
        print(f"aviso: não foi possível validar contra o schema ({e})", file=sys.stderr)
    if problems:
        print('ERROR=schema:' + '; '.join(problems[:6])); sys.exit(0)
else:
    # Checkout sem `api/` (um sparse checkout que trouxe só scripts/) ou execução fora de um
    # clone: as checagens mínimas acima valem, em vez de recusar a publicação por falta do schema.
    # `WARN=` em vez de só stderr: o bash o transforma em anotação do Actions, que aparece no
    # resumo do run. Uma linha no meio do log passa meses sem ninguém ler.
    print('WARN=schema não encontrado neste checkout; o manifesto foi validado SÓ no mínimo (id/runtime/entrypoint)')

# A ficha do app na Loja e na Ajuda mostra os textos do manifesto, e o travessão é o padrão que a
# Ajuda recusa num tópico. Aqui ele é aviso, com o caminho do campo: o texto do manifesto não passa
# pela régua da Ajuda, e recusar um app publicado há meses por pontuação seria desproporcional.
def _travessoes(v, caminho=''):
    if isinstance(v, str): return [caminho or '<raiz>'] if '\u2014' in v else []
    if isinstance(v, list): return [c for i, x in enumerate(v) for c in _travessoes(x, f"{caminho}[{i}]")]
    if isinstance(v, dict): return [c for k, x in v.items() for c in _travessoes(x, f"{caminho}.{k}" if caminho else k)]
    return []
for c in _travessoes(m): print(f"TRAVESSAO={c}")

dev = m.get('developer')
print("DEVELOPER=" + (dev['name'] if isinstance(dev, dict) and isinstance(dev.get('name'), str) else ''))
contrib = m.get('contributes')
print("AJUDA=" + ('1' if isinstance(contrib, dict) and isinstance(contrib.get('ajuda'), dict) else ''))
print(f"ID={app_id}")
print(f"VERSION={version}")
print("ICON=" + (m.get('icon') or ''))
print("CAMADAS=" + ('1' if isinstance(m.get('icone'), dict) else ''))
print("TIPO=" + (m.get('type') if m.get('type') in ('app', 'engine') else 'app'))
PYEOF
)"

APP_ID="" VERSION="" ICON="" ERR="" WARN="" DEVELOPER="" AJUDA="" CAMADAS="" MINSHELL="" TIPO="app"
TRAVESSOES=()
INFO="${INFO//$'\r'/}"   # robustez: python em Windows emite \r\n; header do curl não pode ter \r
while IFS='=' read -r k v; do
  case "${k}" in
    ERROR) ERR="${v}";; ID) APP_ID="${v}";; VERSION) VERSION="${v}";; ICON) ICON="${v}";; WARN) WARN="${v}";;
    DEVELOPER) DEVELOPER="${v}";; AJUDA) AJUDA="${v}";; TRAVESSAO) TRAVESSOES+=("${v}");;
    CAMADAS) CAMADAS="${v}";; MINSHELL) MINSHELL="${v}";; TIPO) TIPO="${v}";;
  esac
done <<< "${INFO}"
[ -z "${WARN}" ] || anotar warning "validação parcial" "${WARN}"
[ -z "${ERR}" ] || { echo "ERRO: vssh-app.json inválido (${ERR})." >&2; exit 1; }
for campo in "${TRAVESSOES[@]}"; do
  anotar warning "travessão no manifesto" \
    "${campo} tem travessão. A ficha do app mostra esse texto; troque por vírgula, ponto, dois-pontos ou parênteses."
done
[ -z "${MINSHELL}" ] || anotar warning "minShellVersion" \
  "O manifesto declara minShellVersion ${MINSHELL}, um campo de saída. A compatibilidade do app passa a ser a ponte dele, que este publish lê do frontend. Tire o campo do manifesto."

# ── 2b. O app ainda cita o vssh-app-toolkit? ──────────────────────────────────
#
# As libs de backend são o runtime `vssh` que todo servidor tem em /opt/vssh/sdk, e um app não
# as instala, não as vendoriza e não as declara. O que esta seção procura é o resto da geração
# anterior: uma dependência `vssh-app-toolkit` num `package.json` do app, ou o `pip install` do
# tarball dele no `installCommand` ou num `requirements`. Encontrada, é um aviso que nomeia a
# versão (a declarada, e a instalada em `node_modules` ou `vendor/py` quando o pacote a leva) e
# diz que o runtime do servidor a substitui, apontando o MIGRATION.md. Sem a citação não há o que
# conferir, e a seção não diz nada.
#
# Aviso, e não recusa: o toolkit continua funcionando enquanto o app o carregar, e o que muda é
# de onde as libs vêm. A publicação segue, e quem lê o resumo do run vê o aviso.
#
# Só o backend entra na conta. O SDK web (`_sdk/vssh.js`) e a biblioteca de UI são servidos pelo
# sistema de dentro do espaço de URL do app, e o pacote não os leva; uma cópia que um app
# carregue por conta própria é dele, e este portão não a procura.
SUBSTITUI="As libs de backend são o runtime \`vssh\` que o servidor já tem (require('vssh') / import vssh), e o app não precisa da dependência. Ver MIGRATION.md."

# Node: cada package.json do app (o da raiz ou o do backend) que declare o toolkit, com a versão
# declarada e, quando o pacote leva node_modules, a instalada.
while IFS= read -r pj; do
  [ -n "${pj}" ] || continue
  ESPEC="$(sed -n 's/.*"vssh-app-toolkit"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${pj}" | head -1)"
  INSTALADA="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$(dirname "${pj}")/node_modules/vssh-app-toolkit/package.json" 2>/dev/null | head -1 || true)"
  anotar warning "libs do toolkit" \
    "${pj#${PKG}/} declara vssh-app-toolkit (${ESPEC:-sem versão}${INSTALADA:+, instalada ${INSTALADA} em node_modules}). ${SUBSTITUI}"
done <<< "$(grep -rl '"vssh-app-toolkit"' --include=package.json "${PKG}" 2>/dev/null | grep -v '/node_modules/' || true)"

# Python: o installCommand do manifesto ou um requirements/pyproject citando o toolkit, com a
# tag do tarball e, quando o pacote leva vendor/py, a versão do `.dist-info` que o `pip install
# --target` escreve (o nome do diretório é normativo, PEP 376).
DECLARA_PY=""
if grep -qE 'vssh[-_]app[-_]toolkit' "${PKG}/vssh-app.json" 2>/dev/null; then
  DECLARA_PY="vssh-app.json (installCommand)"
else
  DECLARA_PY="$(grep -rlE 'vssh[-_]app[-_]toolkit' --include='requirements*.txt' --include='pyproject.toml' \
    "${PKG}" 2>/dev/null | grep -v '/vendor/' | head -1 || true)"
  DECLARA_PY="${DECLARA_PY#${PKG}/}"
fi
if [ -n "${DECLARA_PY}" ]; then
  TAG_PY="$(grep -rhoE 'vssh-app-toolkit/archive/refs/tags/v[0-9]+(\.[0-9]+)*' "${PKG}/vssh-app.json" \
    $(find "${PKG}" -maxdepth 2 \( -name 'requirements*.txt' -o -name 'pyproject.toml' \) -not -path '*/vendor/*' 2>/dev/null) \
    2>/dev/null | head -1 | sed 's|.*/tags/||' || true)"
  INSTALADA_PY="$(find "${PKG}" -type d -name 'vssh_app_toolkit-*.dist-info' -not -path '*/.git/*' 2>/dev/null | head -1 || true)"
  if [ -n "${INSTALADA_PY}" ]; then
    INSTALADA_PY="$(basename "${INSTALADA_PY}")"; INSTALADA_PY="${INSTALADA_PY#vssh_app_toolkit-}"; INSTALADA_PY="${INSTALADA_PY%.dist-info}"
  fi
  anotar warning "libs do toolkit" \
    "${DECLARA_PY} instala vssh-app-toolkit (${TAG_PY:-sem versão}${INSTALADA_PY:+, instalada ${INSTALADA_PY} em vendor/py}). ${SUBSTITUI}"
fi

# ── 2c. A ajuda do app ────────────────────────────────────────────────────────
#
# `compilar-ajuda.mjs` compila a pasta de `contributes.ajuda` com o compilador que o portal executa
# (`api/ajuda/`, gerado pelo sistema) e diz o nível. Uma pasta que não compila recusa a publicação,
# com o arquivo e a linha de cada erro: a ajuda vai para a tela de quem usa o app, e um link
# quebrado ali não tem quem conserte. O nível e as superfícies sem tópico vão para o resumo do run.
#
# Sem `node` ou sem `api/ajuda/` no checkout, a ajuda não é compilada, e o app publica sem ela no
# repositório; o portal ainda a compila do disco da estação. O aviso diz isso no resumo do run.
#
# A regra dos oficiais: um app que a colabhd desenvolve (`developer.name`) publica com cobertura
# total, que é o nível 3, a partir da primeira versão dele que chega lá. O script lê do repositório
# o maior nível já publicado, e a recusa não desliga mais. Antes disso o resumo do run mostra o que
# falta, e os outros apps publicam com qualquer nível.
AJUDA_JSON="${WORKDIR}/ajuda.json"
AJUDA_NIVEL=0
OFICIAL="colabhd"
NOMES_DO_NIVEL=(
  "a Ajuda mostra a ficha gerada do manifesto"
  "o F1 abre o tópico de entrada"
  "toda superfície do manifesto tem tópico"
  "com as figuras do palco do app"
  "com o app respondendo ao Mostrar onde fica"
)
SEM_TOPICO=()
if [ -n "${AJUDA}" ] && ! command -v node >/dev/null 2>&1; then
  anotar warning "ajuda não compilada" \
    "O vssh-app.json declara contributes.ajuda, e este runner não tem node 22.18 ou mais novo. ${APP_ID}@${VERSION} publica sem a ajuda no repositório."
elif [ -n "${AJUDA}" ]; then
  ERROS_DA_AJUDA=()
  set +e
  SAIDA_DA_AJUDA="$(node "$(cd "$(dirname "$0")" && pwd)/compilar-ajuda.mjs" "${PKG}" --saida "${AJUDA_JSON}")"
  CODIGO_DA_AJUDA=$?
  set -e
  while IFS='=' read -r k v; do
    case "${k}" in
      NIVEL) AJUDA_NIVEL="${v}";; SEM_TOPICO) SEM_TOPICO+=("${v}");; ERRO) ERROS_DA_AJUDA+=("${v}");;
      SEM_COMPILADOR) anotar warning "ajuda não compilada" "${v}. ${APP_ID}@${VERSION} publica sem a ajuda no repositório." ;;
    esac
  done <<< "${SAIDA_DA_AJUDA//$'\r'/}"
  if [ "${CODIGO_DA_AJUDA}" = 1 ]; then
    echo "ERRO: a ajuda de ${APP_ID} não compila:" >&2
    printf '  %s\n' "${ERROS_DA_AJUDA[@]}" >&2
    anotar error "ajuda inválida" "$(printf '%s\n' "${ERROS_DA_AJUDA[@]}")"
    exit 1
  elif [ "${CODIGO_DA_AJUDA}" != 0 ] && [ "${CODIGO_DA_AJUDA}" != 3 ]; then
    # O node que existe e não roda (uma biblioteca que falta na imagem) sai com outro código.
    anotar warning "ajuda não compilada" \
      "O compilador da ajuda saiu com o código ${CODIGO_DA_AJUDA}. ${APP_ID}@${VERSION} publica sem a ajuda no repositório."
    rm -f "${AJUDA_JSON}"
  fi
fi

# O palco do app executa os passos da ajuda na janela de verdade, num Chrome, e é dele que saem as
# figuras (o nível 3) e a resposta do app pela ponte (o 4). Sem Chrome, sem backend que suba ou com
# VSSH_SEM_PALCO no ambiente, ele não roda, e o nível fica no que a pasta alcança sozinha. Com o
# palco executado, a ajuda é compilada de novo com o que ele mediu.
PALCO="${WORKDIR}/palco"
FIGURAS=()
FALTAS_DO_PALCO=()
if [ -s "${AJUDA_JSON}" ] && [ -z "${VSSH_SEM_PALCO:-}" ]; then
  set +e
  SAIDA_DO_PALCO="$(node "$(cd "$(dirname "$0")" && pwd)/palco-do-app.mjs" "${PKG}" --saida "${PALCO}" 2>&1)"
  CODIGO_DO_PALCO=$?
  set -e
  MOTIVO_SEM_PALCO=""
  while IFS='=' read -r k v; do
    case "${k}" in FALTA) FALTAS_DO_PALCO+=("${v}");; SEM_PALCO) MOTIVO_SEM_PALCO="${v}";; esac
  done <<< "${SAIDA_DO_PALCO//$'\r'/}"
  if [ "${CODIGO_DO_PALCO}" = 0 ]; then
    [ "${#FALTAS_DO_PALCO[@]}" -eq 0 ] || anotar warning "palco do app" "$(printf '%s\n' "${FALTAS_DO_PALCO[@]}")"
    SEM_TOPICO=()
    SAIDA_DA_AJUDA="$(node "$(cd "$(dirname "$0")" && pwd)/compilar-ajuda.mjs" "${PKG}" --saida "${AJUDA_JSON}" --palco "${PALCO}")"
    while IFS='=' read -r k v; do
      case "${k}" in NIVEL) AJUDA_NIVEL="${v}";; SEM_TOPICO) SEM_TOPICO+=("${v}");; FIGURA) FIGURAS+=("${v}");; esac
    done <<< "${SAIDA_DA_AJUDA//$'\r'/}"
  elif [ "${CODIGO_DO_PALCO}" = 3 ]; then
    anotar notice "palco do app" "O palco não rodou: ${MOTIVO_SEM_PALCO}. O nível fica no que a pasta alcança sem as figuras."
  else
    anotar warning "palco do app" "O palco saiu com o código ${CODIGO_DO_PALCO}: $(printf '%s' "${SAIDA_DO_PALCO}" | tail -n 5)"
  fi
fi

if [ "${DEVELOPER,,}" = "${OFICIAL}" ]; then
  PUBLICADO="$(curl -fsS "${REPO_API}/v1/apps/${APP_ID}/manifest.json" 2>/dev/null || true)"
  MAIOR_PUBLICADO="$(PUBLICADO="${PUBLICADO}" python3 -c '
import json, os
try: d = json.loads(os.environ["PUBLICADO"])
except Exception: d = {}
vs = [d.get("latest") or {}] + (d.get("history") or [])
print(max([v["ajudaNivel"] for v in vs if isinstance(v, dict) and isinstance(v.get("ajudaNivel"), int)] + [0]))')"
  if [ "${MAIOR_PUBLICADO}" -ge 3 ] && [ "${AJUDA_NIVEL}" -lt 3 ]; then
    echo "ERRO: ${APP_ID} é um app oficial, e uma versão anterior publicou com cobertura total (nível ${MAIOR_PUBLICADO})." >&2
    echo "      Esta versão tem nível ${AJUDA_NIVEL}: ${NOMES_DO_NIVEL[${AJUDA_NIVEL}]}." >&2
    [ "${#SEM_TOPICO[@]}" -eq 0 ] || printf '      sem tópico: %s\n' "${SEM_TOPICO[@]}" >&2
    exit 1
  fi
fi

NIVEL_DA_AJUDA="Nível ${AJUDA_NIVEL} de 4: ${NOMES_DO_NIVEL[${AJUDA_NIVEL}]}."
FALTA_AO_OFICIAL=""
[ "${DEVELOPER,,}" != "${OFICIAL}" ] || [ "${AJUDA_NIVEL}" -ge 3 ] \
  || FALTA_AO_OFICIAL="App oficial: a cobertura total é o nível 3, com as figuras do palco do app."
anotar notice "ajuda de ${APP_ID}" "${NIVEL_DA_AJUDA}${SEM_TOPICO[*]:+ Sem tópico: $(printf '%s; ' "${SEM_TOPICO[@]}" | sed 's/; $//').}${FALTA_AO_OFICIAL:+ ${FALTA_AO_OFICIAL}}"
if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
  {
    echo "### A ajuda de ${APP_ID}@${VERSION}"
    echo
    echo "${NIVEL_DA_AJUDA}${FALTA_AO_OFICIAL:+ ${FALTA_AO_OFICIAL}}"
    if [ "${#SEM_TOPICO[@]}" -gt 0 ]; then
      echo
      echo "Sem tópico:"
      echo
      printf -- '- %s\n' "${SEM_TOPICO[@]}"
    fi
    if [ "${#FALTAS_DO_PALCO[@]}" -gt 0 ]; then
      echo
      echo "O que o palco não achou na janela:"
      echo
      printf -- '- %s\n' "${FALTAS_DO_PALCO[@]}"
    fi
    echo
  } >> "${GITHUB_STEP_SUMMARY}"
fi

# ── 2d. O ícone em camadas ─────────────────────────────────────────────────────
#
# Um manifesto com `icone` entrega o glifo e, se quiser, o fundo, e o portal monta as camadas com a
# máscara e o acabamento. `montar-icone.mjs` monta o mesmo SVG com o compositor do portal
# (`api/icone/`, gerado pelo sistema) e o põe no lugar do `icon` (um `.svg`) quando o pacote não
# traz o arquivo: o Worker mostra esse arquivo na Loja antes da instalação, e um portal anterior às
# camadas lê o `icon`. Sem `icon` no manifesto, o montado vai só ao Worker. Uma camada que não está
# no pacote recusa a publicação. O glifo é medido num Chrome, quando há um, e um glifo fora da área
# viva vira aviso no resumo do run, com a caixa medida.
#
# Das mesmas camadas sai o ladrilho, o SVG que a Loja desenha numa caixa de qualquer proporção: o
# fundo até a borda e o glifo inteiro no centro. Ele não entra no pacote, porque o portal o monta
# de um app instalado; vai ao repositório (seção 5), para a Loja de uma estação que ainda não tem o
# app. Um app com janela que não declara `icone` é publicado com um aviso: o ícone pronto dele já
# traz o fundo e o canto, e a Loja só consegue mostrá-lo pequeno, sobre o fundo da família.
ICONE_MONTADO=""
LADRILHO_MONTADO=""
if [ -z "${CAMADAS}" ] && [ "${TIPO}" = "app" ]; then
  anotar warning "app sem ícone em camadas" \
    "O vssh-app.json não declara icone (o glifo e o fundo). A Loja monta o ladrilho de um app com as camadas dele, e sem elas mostra o ícone pronto, pequeno, sobre o fundo da família. O guia é docs/guias/icone.md do vssh-sdk."
fi
if [ -n "${CAMADAS}" ] && ! command -v node >/dev/null 2>&1; then
  anotar warning "ícone não montado" \
    "O vssh-app.json declara icone, e este runner não tem node 22.18 ou mais novo. O portal monta as camadas; a Loja fica sem o ícone de antes da instalação."
elif [ -n "${CAMADAS}" ]; then
  set +e
  SAIDA_DO_ICONE="$(node "$(cd "$(dirname "$0")" && pwd)/montar-icone.mjs" "${PKG}" \
    --saida "${WORKDIR}/icon-montado.svg" --ladrilho "${WORKDIR}/ladrilho.svg")"
  CODIGO_DO_ICONE=$?
  set -e
  while IFS='=' read -r k v; do
    case "${k}" in
      ERRO)           echo "ERRO: icone: ${v}" >&2 ;;
      SEM_COMPOSITOR) anotar warning "ícone não montado" "${v}. O portal monta as camadas; a Loja fica sem o ícone de antes da instalação." ;;
      FORA_DA_GRADE)  anotar warning "ícone fora da grade" "${v}. A grade está em docs/guias/icone.md do vssh-sdk." ;;
      MONTADO)        ICONE_MONTADO="${v}" ;;
      LADRILHO)       LADRILHO_MONTADO="${v}" ;;
      SEM_LADRILHO)   anotar warning "ladrilho não montado" "${v}. A Loja mostra o ícone do app sobre o fundo da família até a estação o instalar." ;;
    esac
  done <<< "${SAIDA_DO_ICONE//$'\r'/}"
  [ "${CODIGO_DO_ICONE}" -ne 1 ] || exit 1
  case "${ICON}" in
    ""|/*|*..*) ;;
    *.svg)
      if [ -n "${ICONE_MONTADO}" ] && [ ! -f "${PKG}/${ICON}" ]; then
        mkdir -p "$(dirname "${PKG}/${ICON}")"
        cp "${ICONE_MONTADO}" "${PKG}/${ICON}"
        echo "Ícone montado das camadas em ${ICON}"
      fi ;;
  esac
fi

# ── 2e. A ponte que a janela usa ──────────────────────────────────────────────
#
# A compatibilidade de um app com o ambiente é a lista dos nomes do SDK web que a janela dele
# chama (`vssh.salas.entrar`, `vssh.arquivos.urlFor`). O publish lê os arquivos da janela, junta os
# nomes da forma `vssh.<espaço>.<nome>` que a superfície do SDK tem (`api/superficie.json`, gerado
# pelo sistema), soma `ponte.exige` do manifesto, tira `ponte.opcional`, e carimba as duas listas
# no manifesto do pacote. O portal confere `exige` antes de instalar.
#
# Os arquivos da janela são os de página (js, ts, html e parentes) que vão no pacote, fora a pasta
# do backend (a primeira pasta do `backend.entrypoint`), `node_modules` e os testes. O backend
# importa o runtime `vssh`, que tem espaços de mesmo nome (`vssh.gpu`), e lê-lo misturaria os dois.
#
# Um nome declarado que a superfície não tem recusa a publicação: o autor o escreveu de propósito.
# Um nome só lido que a superfície não tem vira um aviso com o arquivo e a linha, porque a leitura
# não separa uma chamada de um comentário que cita uma peça que ainda não existe.
#
# Sem `api/superficie.json` no checkout, a ponte não é lida e o pacote sai sem o carimbo, com uma
# anotação. O portal trata o pacote sem `ponte` como não conferido.
SUPERFICIE="$(cd "$(dirname "$0")/.." && pwd)/api/superficie.json"
PONTE_INFO="$(VSSH_PKG="${PKG}" VSSH_MANIFEST_PATH="${MANIFEST}" VSSH_SUPERFICIE_PATH="${SUPERFICIE}" python3 <<'PYEOF'
import json, os, re, subprocess, sys
sys.stdout.reconfigure(encoding='utf-8')
sys.stderr.reconfigure(encoding='utf-8')
pkg = os.environ['VSSH_PKG']
p = os.environ['VSSH_MANIFEST_PATH']
caminho = os.environ.get('VSSH_SUPERFICIE_PATH') or ''
if not os.path.isfile(caminho):
    print('SEM_SUPERFICIE=1'); sys.exit(0)
espacos = json.load(open(caminho, encoding='utf-8')).get('espacos') or {}
m = json.load(open(p, encoding='utf-8'))

def existe(nome):
    espaco, _, membro = nome.partition('.')
    return membro in (espacos.get(espaco) or {})

ponte = m.get('ponte') if isinstance(m.get('ponte'), dict) else {}
declarados = {k: [n for n in (ponte.get(k) or []) if isinstance(n, str)] for k in ('exige', 'opcional')}
desconhecidos = sorted({n for k in declarados for n in declarados[k] if not existe(n)})
if desconhecidos:
    print('ERROR=' + ', '.join(desconhecidos)); sys.exit(0)

backend = m.get('backend') if isinstance(m.get('backend'), dict) else {}
entrada = backend.get('entrypoint') if isinstance(backend.get('entrypoint'), str) else ''
FORA = {'.git', 'node_modules', 'tests', 'test', 'data', '__pycache__'}
if '/' in entrada: FORA.add(entrada.split('/')[0])
PAGINA = ('.js', '.mjs', '.cjs', '.ts', '.tsx', '.jsx', '.html', '.xhtml', '.vue', '.svelte')

def do_pacote():
    # Num repositório git o pacote leva o que o `git add -A` da seção 3 pega: o rastreado e o que
    # o `.gitignore` não exclui. Fora dele, a árvore inteira.
    try:
        saida = subprocess.run(['git', '-C', pkg, 'ls-files', '-z', '--cached', '--others', '--exclude-standard'],
                               capture_output=True, check=True).stdout
        return [n for n in saida.decode('utf-8', 'replace').split('\0') if n]
    except Exception:
        return [os.path.relpath(os.path.join(raiz, f), pkg).replace(os.sep, '/')
                for raiz, _, nomes in os.walk(pkg) for f in nomes]

CHAMADA = re.compile(r'\bvssh\s*\??\.\s*([a-z]+)\s*\??\.\s*([A-Za-z_]\w*)')
lidos, estranhos = set(), {}
for n in sorted(do_pacote()):
    partes = n.split('/')
    if not n.endswith(PAGINA) or n == entrada or set(partes[:-1]) & FORA: continue
    try: texto = open(os.path.join(pkg, n), encoding='utf-8', errors='replace').read()
    except OSError: continue
    if 'vssh' not in texto: continue
    # O texto inteiro, e não linha a linha: uma chamada quebrada em linhas (`vssh` numa, `.salas`
    # na seguinte) é a mesma chamada.
    for achado in CHAMADA.finditer(texto):
        espaco, membro = achado.groups()
        if espaco not in espacos: continue
        if membro in espacos[espaco]: lidos.add(f'{espaco}.{membro}')
        else: estranhos.setdefault(f'{espaco}.{membro}', f"{n}:{texto.count(chr(10), 0, achado.start()) + 1}")

opcional = sorted(set(declarados['opcional']))
exige = sorted((lidos | set(declarados['exige'])) - set(opcional))
m['ponte'] = {'exige': exige, 'opcional': opcional}
json.dump(m, open(p, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)

for nome, onde in sorted(estranhos.items()): print(f'ESTRANHO={nome} ({onde})')
print(f'LIDOS={len(lidos)}')
print(f"DECLARADOS={len(set(declarados['exige']) | set(declarados['opcional']))}")
print(f'EXIGE={len(exige)}')
print(f'OPCIONAL={len(opcional)}')
# Um motor ou um serviço não tem janela, e a lista vazia dele não diz nada.
tem_janela = m.get('type') != 'engine' and m.get('kind') != 'service'
if tem_janela and not exige and not opcional: print('VAZIA=1')
PYEOF
)"

PONTE_ERRO="" SEM_SUPERFICIE="" PONTE_LIDOS=0 PONTE_DECLARADOS=0 PONTE_EXIGE=0 PONTE_OPCIONAL=0 PONTE_VAZIA=""
PONTE_ESTRANHOS=()
PONTE_INFO="${PONTE_INFO//$'\r'/}"
while IFS='=' read -r k v; do
  case "${k}" in
    ERROR) PONTE_ERRO="${v}";; SEM_SUPERFICIE) SEM_SUPERFICIE=1;; ESTRANHO) PONTE_ESTRANHOS+=("${v}");;
    LIDOS) PONTE_LIDOS="${v}";; DECLARADOS) PONTE_DECLARADOS="${v}";; EXIGE) PONTE_EXIGE="${v}";;
    OPCIONAL) PONTE_OPCIONAL="${v}";; VAZIA) PONTE_VAZIA=1;;
  esac
done <<< "${PONTE_INFO}"
if [ -n "${PONTE_ERRO}" ]; then
  anotar error "ponte" \
    "O manifesto declara em ponte um nome que o SDK web não tem: ${PONTE_ERRO}. Os nomes que existem estão em api/superficie.json do vssh-sdk."
  echo "ERRO: ponte com nome desconhecido (${PONTE_ERRO})." >&2
  exit 1
fi
if [ -n "${SEM_SUPERFICIE}" ]; then
  anotar notice "ponte não lida" \
    "api/superficie.json não está neste checkout do vssh-sdk. ${APP_ID}@${VERSION} publica sem a ponte carimbada, e o portal não a confere."
else
  for estranho in "${PONTE_ESTRANHOS[@]}"; do
    anotar warning "ponte" \
      "A leitura achou vssh.${estranho}, e o SDK web não tem esse nome. Uma chamada a ele falha na janela; um comentário ou um texto que o cita não pede nada."
  done
  anotar notice "ponte de ${APP_ID}" \
    "${PONTE_LIDOS} nomes lidos do frontend e ${PONTE_DECLARADOS} declarados no manifesto. O pacote exige ${PONTE_EXIGE} e dispensa ${PONTE_OPCIONAL}."
  [ -z "${PONTE_VAZIA}" ] || anotar warning "ponte vazia" \
    "Nenhum nome do SDK web foi achado em ${APP_ID}. Ou a janela não chama a ponte, ou a chama por um caminho que a leitura não vê (um acessor do próprio app): nesse caso, declare os nomes em ponte.exige no manifesto."
fi

# ── 3. A versão interna ───────────────────────────────────────────────────────
#
# O instante desta publicação em UTC, como o inteiro `AAAAMMDDhhmmss`. O relógio a dá uma vez, aqui,
# e todo repositório que recebe o lote recebe o mesmo número. Quem completa uma publicação que
# falhou num repositório passa a interna dela por `--internal-version`.
[ -n "${INTERNA}" ] || INTERNA="$(date -u +%Y%m%d%H%M%S)"
[[ "${INTERNA}" =~ ^[0-9]{14}$ ]] || { echo "ERRO: a versão interna é o instante da publicação em UTC, com 14 algarismos (AAAAMMDDhhmmss); veio '${INTERNA}'." >&2; exit 1; }

# O manifesto do pacote leva a interna em `internalVersion`, e é dele que a estação a lê depois de
# instalar. O schema do manifesto é fechado: um repositório recusa o campo que o schema não declara,
# então o carimbo só entra quando o schema deste checkout já o tem. O header a leva de todo jeito.
CARIMBADO="$(VSSH_MANIFEST_PATH="${MANIFEST}" VSSH_SCHEMA_PATH="${SCHEMA}" VSSH_INTERNA="${INTERNA}" python3 <<'PYEOF'
import json, os
try:
    declara = 'internalVersion' in json.load(open(os.environ['VSSH_SCHEMA_PATH'], encoding='utf-8')).get('properties', {})
except Exception:
    declara = False
if declara:
    p = os.environ['VSSH_MANIFEST_PATH']
    m = json.load(open(p, encoding='utf-8'))
    m['internalVersion'] = int(os.environ['VSSH_INTERNA'])
    json.dump(m, open(p, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
print('1' if declara else '')
PYEOF
)"
CARIMBADO="${CARIMBADO//$'\r'/}"

# ── 3b. Empacota (só o que está versionado, quando é repo git) ─────────────────
#
# O lote é a pasta com tudo o que um repositório recebe: o pacote, o manifesto dele, as notas, a
# ajuda com as figuras, o ícone e o ladrilho, e `lote.txt`, que diz o app, a versão, a interna e o
# sha256 do pacote. `--empacotar` a deixa onde foi pedida, para `--enviar` mandar a cada repositório.
LOTE="${EMPACOTAR:-${WORKDIR}/lote}"
mkdir -p "${LOTE}"
[ -z "$(ls -A "${LOTE}")" ] || { echo "ERRO: a pasta do lote ('${LOTE}') não está vazia." >&2; exit 1; }
TARBALL="${LOTE}/app.tar.gz"
# `--version` e a interna reescreveram o vssh-app.json no PKG acima; para o `git archive` levar
# esse manifesto (e quaisquer node_modules/vendor NÃO rastreados no clone raso) o commitamos numa
# árvore efêmera.
if git -C "${PKG}" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "${PKG}" add -A
  # commit efêmero só para snapshotar a árvore de trabalho (inclui vendorizados rastreados +
  # a version reescrita); identidade fixa para não depender de config global do runner.
  GIT_AUTHOR_NAME=vssh GIT_AUTHOR_EMAIL=vssh@localhost \
  GIT_COMMITTER_NAME=vssh GIT_COMMITTER_EMAIL=vssh@localhost \
    git -C "${PKG}" commit -q --no-verify -m "publish snapshot" >/dev/null 2>&1 || true
  git -C "${PKG}" archive --format=tar HEAD | gzip -n > "${TARBALL}"
else
  tar -czf "${TARBALL}" \
    --exclude="./.git" --exclude="./data" --exclude="./__pycache__" --exclude="*.pyc" \
    -C "${PKG}" .
fi
SHA256="$(sha256sum "${TARBALL}" | cut -d' ' -f1)"
cp "${MANIFEST}" "${LOTE}/manifesto.json"
[ -z "${NOTES}" ] || printf '%s' "${NOTES}" > "${LOTE}/notas.md"

# A coleção de quem publica: o `colecao.json` da pasta do app ou, numa suíte com vários apps, o da
# raiz do repositório dela. Ele diz o id, o nome, de quem é e o resumo da coleção, e `apps`, quando
# vem, os apps que entram nela. O repositório guarda a coleção com a versão, e a coleção de um app
# é a que a versão atual dele declara: um app despublicado sai dela sozinho.
COLECAO_DA_FONTE=""
for c in "${SRC}/colecao.json" "$(git -C "${SRC}" rev-parse --show-toplevel 2>/dev/null || true)/colecao.json" "${PKG}/colecao.json"; do
  if [ -f "${c}" ]; then COLECAO_DA_FONTE="${c}"; break; fi
done
if [ -n "${COLECAO_DA_FONTE}" ]; then
  VSSH_COLECAO="${COLECAO_DA_FONTE}" VSSH_APP_ID="${APP_ID}" VSSH_COLECAO_SAIDA="${LOTE}/colecao.json" \
    PYTHONIOENCODING=utf-8 python3 - <<'PYEOF' || exit 1
import json, os, re, sys
caminho, app = os.environ['VSSH_COLECAO'], os.environ['VSSH_APP_ID']
try:
    with open(caminho, encoding='utf-8') as f:
        c = json.load(f)
except Exception as e:
    sys.exit(f"ERRO: {caminho} não é JSON: {e}")
def texto(chave, maximo, obrigatorio=False):
    v = c.get(chave)
    if v is None and not obrigatorio:
        return None
    if not isinstance(v, str) or not v.strip() or len(v) > maximo:
        sys.exit(f"ERRO: em {caminho}, `{chave}` é um texto de até {maximo} caracteres.")
    return v.strip()
if not isinstance(c, dict) or not isinstance(c.get('id'), str) or not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,63}', c['id']):
    sys.exit(f"ERRO: em {caminho}, `id` é minúsculo, com algarismos e hífen, até 64 caracteres.")
saida = {'id': c['id'], 'nome': texto('nome', 80, True)}
for chave, maximo in (('quem', 80), ('resumo', 400)):
    v = texto(chave, maximo)
    if v is not None:
        saida[chave] = v
apps = c.get('apps')
if apps is not None and (not isinstance(apps, list) or not all(isinstance(a, str) for a in apps)):
    sys.exit(f"ERRO: em {caminho}, `apps` é uma lista de ids.")
if apps is not None and app not in apps:
    print(f"A coleção '{c['id']}' não lista {app}: o app vai sem coleção.")
    sys.exit(0)
with open(os.environ['VSSH_COLECAO_SAIDA'], 'w', encoding='utf-8') as f:
    json.dump(saida, f, ensure_ascii=False, separators=(',', ':'))
print(f"Coleção: {saida['nome']} ({saida['id']}).")
PYEOF
fi

if [ -s "${AJUDA_JSON}" ]; then
  cp "${AJUDA_JSON}" "${LOTE}/ajuda.json"
  mkdir -p "${LOTE}/figuras"
  for f in "${FIGURAS[@]}"; do cp "${PALCO}/${f}" "${LOTE}/figuras/${f}"; done
fi

# O ícone que vai ao repositório como o da versão: o de `--icon`, o que o pacote traz, ou o montado
# das camadas.
ICON_PATH=""
[ -n "${ICON_OVERRIDE}" ] && ICON_PATH="${ICON_OVERRIDE}"
[ -z "${ICON_PATH}" ] && [ -n "${ICON}" ] && [ -f "${PKG}/${ICON}" ] && ICON_PATH="${PKG}/${ICON}"
[ -z "${ICON_PATH}" ] && [ -n "${ICONE_MONTADO}" ] && ICON_PATH="${ICONE_MONTADO}"
ICONE_DO_LOTE="" ICONE_TIPO=""
if [ -n "${ICON_PATH}" ] && [ -f "${ICON_PATH}" ]; then
  case "${ICON_PATH,,}" in
    *.png) ICONE_TIPO=image/png; ICONE_DO_LOTE=icone.png ;;
    *.svg) ICONE_TIPO=image/svg+xml; ICONE_DO_LOTE=icone.svg ;;
    *.ico) ICONE_TIPO=image/x-icon; ICONE_DO_LOTE=icone.ico ;;
    *.jpg|*.jpeg) ICONE_TIPO=image/jpeg; ICONE_DO_LOTE=icone.jpg ;;
    *) ICONE_TIPO=application/octet-stream; ICONE_DO_LOTE=icone.bin ;;
  esac
  cp "${ICON_PATH}" "${LOTE}/${ICONE_DO_LOTE}"
fi
if [ -n "${LADRILHO_MONTADO}" ] && [ -f "${LADRILHO_MONTADO}" ]; then cp "${LADRILHO_MONTADO}" "${LOTE}/ladrilho.svg"; fi

{
  echo "APP_ID=${APP_ID}"
  echo "VERSION=${VERSION}"
  echo "INTERNA=${INTERNA}"
  echo "SHA256=${SHA256}"
  echo "BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "BUILD_ID=${GITHUB_SHA:-${VERSION}}"
  echo "REF=${GITHUB_REF_NAME:-}"
  echo "AJUDA_NIVEL=${AJUDA_NIVEL}"
  echo "ICONE=${ICONE_DO_LOTE}"
  echo "ICONE_TIPO=${ICONE_TIPO}"
  for f in "${FIGURAS[@]}"; do echo "FIGURA=${f}"; done
} > "${LOTE}/lote.txt"

echo "Empacotado ${APP_ID}@${VERSION}, interna ${INTERNA} (${SHA256}, $(stat -c%s "${TARBALL}" 2>/dev/null || wc -c < "${TARBALL}") bytes)"
[ -n "${CARIMBADO}" ] || anotar notice "interna fora do manifesto" \
  "O schema deste checkout ainda não declara internalVersion, e o manifesto do pacote saiu sem a interna. Ela vai ao repositório no header."
if [ -n "${GITHUB_OUTPUT:-}" ]; then
  { echo "app_id=${APP_ID}"; echo "version=${VERSION}"; echo "internal_version=${INTERNA}"; } >> "${GITHUB_OUTPUT}"
fi

if [ -n "${EMPACOTAR}" ]; then
  echo "O lote está em ${LOTE}. Mande-o a cada repositório com: vssh-app-publish --enviar ${LOTE} --repo-api <endereço>"
  exit 0
fi

# ── 4. Envia ao repositório ────────────────────────────────────────────────────
enviar_lote "${LOTE}"
