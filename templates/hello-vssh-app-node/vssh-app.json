{
  "id": "hello-world-node",
  "name": "Hello World (Node)",
  "version": "5.0.0",
  "icon": "icon.svg",
  "category": "Utility",
  "developer": { "name": "colabhd", "url": "https://github.com/colabhd" },
  "license": "MIT",
  "description": "Um app de exemplo, com backend em Node, para quem escreve apps: mostra a ponte com o ambiente, o acesso a arquivos, a bandeja, o som, a impressão, o cofre de segredos e a fila de processamento.",
  "requiredPackages": [
    "ffmpeg"
  ],
  "gpu": true,
  "recursos": {
    "fila": true
  },
  "resources": {
    "memoryMax": "512M",
    "tasksMax": "128"
  },
  "secrets": [
    {
      "name": "HELLO_SEGREDO",
      "description": "Qualquer texto. Serve só para demonstrar o cofre: guarde aqui, reinicie o app, e a galeria mostra que ele chegou — sem nunca mostrar o valor.",
      "required": false
    }
  ],
  "opens": {
    "extensions": [
      "hello"
    ]
  },
  "handles": "editor",
  "contributes": {
    "settings": "configuracoes.js",
    "settingsOptIn": true,
    "contextMenu": [
      {
        "id": "painel",
        "superficie": "icone-do-app",
        "rotulo": "Abrir o painel",
        "acao": "abrirRota",
        "rota": "?painel=1",
        "ordem": 12
      }
    ]
  },
  "minShellVersion": "5.0.0",
  "backend": {
    "runtime": "node",
    "transport": "socket",
    "entrypoint": "backend/server.js",
    "healthcheckPath": "/saude",
    "aoFechar": "encerrar"
  },
  "window": {
    "title": "Hello World (Node)",
    "width": 900,
    "height": 640
  }
}
